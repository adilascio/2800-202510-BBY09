<!DOCTYPE html>
<html lang="en">

<head>
  <!-- META -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Daily Word Game</title>

  <!-- CSS -->
  <link rel="stylesheet" href="/css/index.css" />
  <link rel="stylesheet" href="/css/game.css" />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css"
  />

</head>

<body>
  <!-- HEADER (with soft cyan gradient) -->
  <div class="gradient-soft">
    <%- include('templates/header', { pageTitle: 'Puzzle' }) %>
  </div>

  <!-- MAIN CONTENT -->
  <main class="container-fluid d-flex justify-content-center align-items-center py-5">
    <div class="col-12 col-md-8 col-lg-6">
      <div class="card card-transparent">
        <div class="card-body">

          <!-- Title with accent -->
          <h2 class="text-center mb-4 ">Daily Word Game</h2>

          <!-- Language Selector -->
          <div class="mb-4 text-center">
            <label for="language-select" class="form-label fw-bold d-block">
              Select Language:
            </label>
            <select
              id="language-select"
              class="form-select w-auto mx-auto"
            >
              <option value="en">English</option>
              <option value="fr">French</option>
              <option value="es">Spanish</option>
              <option value="de">German</option>
              <option value="it">Italian</option>
              <option value="ja">Japanese</option>
            </select>
          </div>

          <!-- Instructions -->
          <p class="lead text-center mb-4">
            Use the letters below to form as many words as you can. Each letter can be used only once!
          </p>

          <!-- Letter Bank -->
          <div id="letter-bank" class="my-4 fs-3 fw-bold text-center"></div>

          <!-- Input + Submit -->
          <div class="d-flex justify-content-center mb-4">
            <input
              type="text"
              id="word-input"
              class="form-control w-50"
              placeholder="Enter a word..."
            />
            <button
              id="submit-word"
              class="btn btn-accent ms-3"
            >
              Submit
            </button>
          </div>

          <!-- Feedback -->
          <div id="feedback" class="text-danger mb-4"></div>

          <!-- Found Words -->
          <div id="found-words" class="text-start">
            <h5>Words You Found:</h5>
            <ul id="word-list" class="list-unstyled mb-0"></ul>
          </div>

        </div>
      </div>
    </div>
  </main>

  <!-- NAVBAR -->
  <%- include('templates/navbar', { activeTab: 'puzzles' }) %>

  <!-- SCRIPTS -->
  <script>
    // server-injected data
    window.usedWordsFromServer = JSON.parse(
      `<%- JSON.stringify(typeof result !== 'undefined' ? result : []) %>`
    );
  </script>
  <script src="/js/game.js"></script>
</body>
</html>
