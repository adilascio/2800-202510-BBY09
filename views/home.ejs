<!DOCTYPE html>
<html lang="en">

<head>
  <!-- ── META ─────────────────────────────────────────────────────── -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Home</title>

  <!-- ── CSS LINKS ───────────────────────────────────────────────── -->
  <link rel="stylesheet" href="/css/index.css" />
  <link rel="stylesheet" href="/css/home.css" />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css"
  />
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
  />
  <link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
  />

</head>

<body>
  <!-- HEADER -->
  <%- include('templates/header', { pageTitle: 'Home' }) %>

  <!-- SPLASH ANIMATION -->
  <% if (showAnimation) { %>
    <div class="animation-container" id="animationContainer">
      <div class="welcome-text">Hello!</div>
      <div class="welcome-text">Bonjour!</div>
      <div class="welcome-text">Hola!</div>
      <div class="globe">
        <div class="sparkle"></div>
        <div class="sparkle"></div>
        <div class="sparkle"></div>
      </div>
    </div>
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const anim = document.getElementById("animationContainer");
        const main = document.querySelector(".main-content");
        setTimeout(() => {
          anim.classList.add("hidden");
          main.classList.add("visible");
        }, 3000);
      });
    </script>
  <% } %>

  <!-- MAIN CONTENT -->
  <main
    class="container text-center mt-5 main-content<%= showAnimation ? '' : ' visible' %>"
  >
    <div class="card-transparent mx-auto mt-4" style="max-width: 400px;">
      <h4 class="m-0">Hi, <%= user.name %>!</h4>
      <br>
      
      <!-- Daily Progress -->
      <section class="mb-4">
        <!-- Points (circular) -->
        <div class="mb-3 text-center">
          <h6>
            Points
            <i
              id="pointsInfo"
              class="bi bi-info-circle ms-2"
              style="cursor: pointer;"
              title="What are points?"
            ></i>
          </h6>

          <div class="circular-progress-container mx-auto">
            <svg class="circular-progress" viewBox="0 0 100 100">
              <defs>
                <linearGradient id="progressGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#A0E9FD"/>
                  <stop offset="100%" stop-color="#60D0F7"/>
                </linearGradient>
              </defs>
              <circle class="progress-bg" cx="50" cy="50" r="45" />
              <!-- <circle
                class="progress-bar"
                cx="50"
                cy="50"
                r="45"
                stroke="url(#progressGradient)"
                style="--pct: <%= Math.min((user.points/99)*100,100) %>;"
              /> -->
              <circle class="progress-bar" cx="50" cy="50" r="45"
                stroke="url(#progressGradient)"
                style="--pct: 60;"/>
            </svg>

            <img
              src="<%= user.profilePic || '/svgs/profile.svg' %>"
              alt="Profile"
              class="profile-pic-progress"
            />
          </div>
        </div>

        <!-- Login Streak -->
        <div>
          <h6>Login Streak</h6>
          <div class="progress streak-progress-container mb-2">
            <div
              class="progress-bar bg-info"
              role="progressbar"
              style="width: 60%"
              aria-valuenow="6"
              aria-valuemin="0"
              aria-valuemax="10"
            ></div>
            <span
              class="streak-pointer"
              style="left: 60%;"
              
              >🔥</span
            >
          </div>
          <small><%= Math.min(user.loginStreak,10) %> / 10 days</small>
        </div>
      </section>

      <!-- Daily Tasks Grid -->
      <section class="row gx-3 gy-4">
        <!-- Messaging -->
        <div class="col-12 col-md-6">
          <div class="card h-100">
            <div class="card-body d-flex flex-column">
              <h5 class="card-title">Daily Messaging</h5>
                <p class="flex-grow-1">
                  Chat with your friends to earn points!
                </p>
                <a href="/messages" class="btn btn-info mt-auto">Go to Messages</a>

            </div>
          </div>
        </div>

        <!-- Puzzle -->
        <div class="col-12 col-md-6">
          <div class="card h-100">
            <div class="card-body d-flex flex-column">
              <h5 class="card-title">Daily Puzzle</h5>
              <% if (!hasPlayedToday) { %>
                <p class="flex-grow-1">
                  You haven’t completed today’s puzzle yet. Earn 1 point by
                  playing.
                </p>
                <a href="/game" class="btn btn-info mt-auto">Play Puzzle</a>
              <% } else { %>
                <p class="flex-grow-1">
                  Great job! You’ve earned your puzzle point today.
                </p>
                <a
                  href="/game"
                  class="btn btn-outline-primary mt-auto"
                  >Play Again</a
                >
              <% } %>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <!-- NAVBAR & ADD FRIENDS ALERT -->
  <%- include('templates/navbar', { activeTab: 'home' }) %>
  <% if (requestCount === 0) { %>
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        Swal.fire({
          toast: true,
          position: "bottom-start",
          showConfirmButton: false,
          customClass: {
            container: "my-swal-container",
            popup: "p-0 m-0 border-0",
          },
          html: `
            <div class="card" style="max-width:300px;margin:0">
              <div class="card-body p-3">
                <h5 class="card-title text-primary mb-2">Add Friends 🙋‍♂️</h5>
                <a
                  href="/friends"
                  class="btn btn-primary btn-sm w-100 animate__animated animate__pulse"
                  >Get started by adding friends!</a
                >
              </div>
            </div>`,
          timer: 8000,
          timerProgressBar: true,
        });
      });
    </script>
  <% } %>

  <!-- THIRD-PARTY SCRIPTS -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <% if (showProfilePrompt) { %>
    <script>
      Swal.fire({
        title: "Create Your Profile",
        text: "Would you like to create your profile now?",
        icon: "info",
        showCancelButton: true,
        confirmButtonText: "Create Profile",
        cancelButtonText: "Later",
      }).then((result) => {
        if (result.isConfirmed) {
          window.location.href = "/profile";
        }
      });
    </script>
  <% } %>
  <script>
  document
    .getElementById('pointsInfo')
    .addEventListener('click', () => {
      Swal.fire({
        title: 'How Points Work',
        icon: 'info',
        html: `
          <ul style="text-align:left">
            <li><strong>+1</strong> for your first chat each day</li>
            <li><strong>+1</strong> for your first puzzle each day</li>
            <li><strong>+1</strong> bonus if you do both in the same day</li>
            <li><strong>+3</strong> bonus when you hit a 10-day login streak</li>
          </ul>
        `,
        confirmButtonText: 'Got it!'
      });
    });
</script>

</body>
</html>
