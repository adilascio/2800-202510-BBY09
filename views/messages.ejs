<!DOCTYPE html>
<html lang="en">
<head>
  <!-- META -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle || 'Messages' %></title>

  <!-- BOOTSTRAP & ICONS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
    rel="stylesheet"
  />

  <!-- YOUR CSS -->
  <link rel="stylesheet" href="/css/index.css" />
  <link rel="stylesheet" href="/css/messages.css" />

</head>

<body>
  <!-- HEADER -->
  <div class="gradient-soft">
    <%- include('templates/header', { pageTitle }) %>
  </div>

  <!-- MAIN CONTENT -->
  <main class="container-fluid d-flex justify-content-center align-items-start py-5">
    <div class="col-12 col-md-8 col-lg-6">
      <div class="card card-transparent p-4">

        <!-- Page Title -->
        <h3 class="text-center mb-4 ">Your Chats</h3>

        <!-- Search Bar -->
        <div class="input-group mb-4">
          <input
            type="text"
            id="searchInput"
            class="form-control"
            placeholder="Search by name or username..."
          />
          <button class="btn-accent btn">
            <i class="bi bi-search"></i>
          </button>
        </div>

        <!-- Friend List -->
        <% const list = Array.isArray(friends) ? friends : []; %>
        <% if (list.length === 0) { %>
          <p class="text-center text-muted">You don't have any friends yet.</p>
        <% } else { %>
          <div id="friendList">
            <% list.forEach(friend => { %>
              <div class="friend-card">
                <a
                  href="/profile/<%= friend.username %>"
                  class="d-flex align-items-center text-decoration-none text-dark"
                >
                  <img
                    src="<%= friend.profilePic || '/svgs/person.svg' %>"
                    alt="Avatar of <%= friend.name %>"
                    class="friend-avatar"
                  />
                  <div>
                    <p class="mb-0 fw-semibold"><%= friend.name %></p>
                    <small class="text-secondary">@<%= friend.username %></small>
                  </div>
                </a>
                <button
                  onclick="location.href='/chat/<%= friend.chatId %>'"
                  class="message-btn"
                  title="Message <%= friend.name %>"
                >
                  <i class="bi bi-chat-dots-fill"></i>
                </button>
              </div>
            <% }); %>
          </div>
        <% } %>

      </div>
    </div>
  </main>

  <!-- NAVBAR -->
  <%- include('templates/navbar', { activeTab: 'messages' }) %>

  <!-- LIVE SEARCH SCRIPT -->
  <script>
    document.getElementById('searchInput').addEventListener('input', function () {
      const q = this.value.toLowerCase();
      document.querySelectorAll('.friend-card').forEach(card => {
        const name = card.querySelector('.fw-semibold').textContent.toLowerCase();
        const uname = card.querySelector('small').textContent.toLowerCase();
        card.style.display =
          name.includes(q) || uname.includes(q) ? '' : 'none';
      });
    });
  </script>
</body>
</html>
