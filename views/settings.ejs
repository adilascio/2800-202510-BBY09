<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Settings</title>

  <!-- Styles -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css"/>
  <link rel="stylesheet" href="/styles/settings.css" />
</head>

<body>
  <%- include('templates/header', { pageTitle: 'Settings' }) %>

  <main class="container d-flex justify-content-center">
    <div class="col-12 col-md-8 col-lg-6 card-transparent">
      <h3 class="mb-4 text-center">Settings</h3>

      <form action="/settings" method="POST">
        <input type="hidden" name="lat" id="latInput">
        <input type="hidden" name="lng" id="lngInput">

        <!-- Toggle: Share Location -->
        <div class="form-check form-switch mb-4">
          <input class="form-check-input" type="checkbox" name="shareLocation" id="shareLocationToggle"
            <%= user.shareLocation ? 'checked' : '' %>>
          <label class="form-check-label" for="shareLocationToggle">
            Enable Location Sharing
          </label>
        </div>

        <!-- Toggle: Passport Animation -->
        <div class="form-check form-switch mb-4">
          <input class="form-check-input" type="checkbox" name="passportAnimation" id="passportAnimationToggle"
            <%= user.passportAnimation ? 'checked' : '' %>>
          <label class="form-check-label" for="passportAnimationToggle">
            Enable Passport Opening Animation
          </label>
        </div>

        <!-- Save button -->
        <div class="d-grid">
          <button type="submit" class="btn btn-primary">Save Settings</button>
        </div>
      </form>

      <!-- Danger Zone -->
      <div class="danger-zone mt-5">
        <h5 class="mb-3">Danger Zone</h5>
        <button id="deleteAccountBtn" class="btn btn-danger w-100">
          <i class="bi bi-trash me-2"></i>Delete My Account
        </button>
      </div>

      <div class="text-center mt-4">
        <a href="/profile" class="btn btn-outline-secondary">Back to Profile</a>
      </div>
    </div>
  </main>

  <%- include('templates/navbar', { activeTab: '' }) %>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/js/settings.js"></script>
</body>
</html>
