<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= user2.name %>'s Profile</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet" />
  <link href="https://unpkg.com/leaflet/dist/leaflet.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/publicProfile.css" />

  <style>
    
  </style>
</head>

<body>
  <%- include('templates/header', { pageTitle: user2.name + "'s Profile" }) %>
  <div class="passport-container">
    <div class="passport-map">
      <div id="map"></div>
    </div>

    <div class="passport-header">
      <div class="passport-title-line">
        <span class="passport-title">PASSPORT</span>
        <span id="location">
          <span id="country-code">N/A</span> <span id="flag-emoji">🌍</span>
        </span>
      </div>
    </div>

    <div class="passport-body">
      <div class="photo-section text-center mb-3">
        <img src="<%= user2.profilePic || '/svgs/person.svg' %>" alt="Profile Picture" />
      </div>

      <div class="info-section">
        <div>
          <div class="info-label">Full Name</div>
          <div class="info-value"><%= user2.name %></div>
        </div>
        <div>
          <div class="info-label">Email</div>
          <div class="info-value"><%= user2.username %></div>
        </div>
        <div>
          <div class="info-label">Username</div>
          <div class="info-value"><%= user2.username %></div>
        </div>
        <div>
          <div class="info-label">Native Language</div>
          <div class="info-value"><%= user2.nativeLanguage || '—' %></div>
        </div>
        <div>
          <div class="info-label">Learning</div>
          <div class="info-value"><%= user2.targetLanguage || '—' %></div>
        </div>
        <div>
          <div class="info-label">Birthdate</div>
          <div class="info-value">
            <%= user2.birthdate ? user2.birthdate.toISOString().split('T')[0] : '—' %>
          </div>
        </div>
      </div>

      <div class="passport-code" id="passportCode"></div>
    </div>
  </div>

  <div class="text-center mt-3">
    <% if (!isOwnProfile) { %>
      <% if (from === 'messages') { %>
        <a href="/chat/<%= [currentUser.username, user2.username].sort().join('_') %>" class="btn btn-primary">
          Message <%= user2.name.split(' ')[0] %>
        </a>
      <% } else if (from === 'friends') { %>
        <form action="/add-friend/<%= user2._id %>" method="POST" style="display:inline;">
          <button type="submit" class="btn btn-success">
            Add <%= user2.name.split(' ')[0] %>
          </button>
        </form>
      <% } else { %>
        <!-- fallback: just show username or disable button -->
        <button class="btn btn-secondary" disabled>
          View Only
        </button>
      <% } %>
    <% } else { %>
      <a href="/profile" class="btn btn-secondary">Edit Your Profile</a>
    <% } %>
  </div>
  

  <div id="videoOverlay" style="
  position: fixed;
  top: 60px;
  bottom: 65px;
  left: 0;
  right: 0;
  z-index: 9999;
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
">
  <video id="passportIntro" autoplay muted playsinline style="
    width: 100%;
    height: 100%;
    object-fit: cover;
  ">
    <source src="/vid/Passport-opening-animation.mp4" type="video/mp4" />
    Your browser does not support the video tag.
  </video>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const video = document.getElementById("passportIntro");
    const overlay = document.getElementById("videoOverlay");

    // Ensure scrolling is disabled while video plays
    document.body.style.overflow = "hidden";

    video.onended = () => {
      overlay.style.display = "none";
      document.body.style.overflow = "";
    };

    overlay.addEventListener("click", () => {
      video.pause();
      overlay.style.display = "none";
      document.body.style.overflow = "";
    });
  });
</script>

<script>
  const lat = <%= JSON.stringify(user2.location && user2.location.lat || 0) %>;
  const lng = <%= JSON.stringify(user2.location && user2.location.lng || 0) %>;
</script>



<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
  <script>
    function flagFromCode(code) {
      return code.toUpperCase().split('').map(c => String.fromCodePoint(127397 + c.charCodeAt())).join('');
    }

    if (lat && lng) {
      const map = L.map('map').setView([lat, lng], 10);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
      }).addTo(map);
      L.marker([lat, lng]).addTo(map).bindPopup("<%= user2.name %>'s Location").openPopup();
    }

    async function detectCountryCode(lat, lng) {
      const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`);
      const data = await res.json();
      const code = data.address?.country_code?.toUpperCase() || "XX";
      document.getElementById("country-code").textContent = code;
      document.getElementById("flag-emoji").textContent = flagFromCode(code);
    }

    if (lat && lng) detectCountryCode(lat, lng);

  function updatePassportCode() {
    const name = "<%= (user2.name || '').toUpperCase() %>";
    const username = "<%= (user2.username || '').toUpperCase() %>";
    const native = "<%= (user2.nativeLanguage || '').toUpperCase() %>";
    const target = "<%= (user2.targetLanguage || '').toUpperCase() %>";
    const pad = (txt, len = 15) => (txt + "<<<<<<<<<<<<<<<<<<<<<").slice(0, len);
    const line1 = `<<${pad(username)}<<<<<<<<<<${pad(name)}<<<<<<<<<<<<<<<<<<<<<`;
    const line2 = `<<<<<<<<<<<<<${pad(target)}<<<<<<<<<<${pad(native)}<<<<<<<<<<`;
    document.getElementById("passportCode").innerText = `${line1}\n${line2}`;
  }


    updatePassportCode();
  </script>

  <%- include('templates/navbar', { activeTab: '' }) %>
</body>
</html>


