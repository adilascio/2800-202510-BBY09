<!DOCTYPE html>
<html lang="en">

<head>
  <!-- META -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>AI Tutor</title>

  <!-- CSS -->
  <link rel="stylesheet" href="/css/index.css" />
  <link rel="stylesheet" href="/css/tutor.css" />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css"
  />

  <!-- INLINE STYLES -->
  <style>


  </style>
</head>

<body>
  <!-- HEADER with soft gradient -->
  <div class="gradient-soft">
    <%- include('templates/header', { pageTitle: 'AI Tutor' }) %>
  </div>

  <!-- MAIN: centered responsive card -->
  <main class="container-fluid d-flex justify-content-center align-items-start py-5">
    <div class="col-12 col-md-8 col-lg-6">
      <div class="card card-transparent">
        <div class="card-body">

          <!-- Tutor Selector Card  -->
          <div class="card mb-4 card-transparent mx-auto tutor-selector-card">
            <div class="card-body text-center">
              <!-- Tutor Image -->
              <img
                src="/img/LingoTutor.png"
                alt="LingoLink Tutor"
                class="img-fluid"
              />

              <!-- Dropdown -->
              <select id="tutorSelect" class="form-select card-transparent">
                <option value="english" <%= selectedTutor==='english'? 'selected':'' %>>
                  English Tutor
                </option>
                <option value="spanish" <%= selectedTutor==='spanish'? 'selected':'' %>>
                  Spanish Tutor
                </option>
                <option value="french" <%= selectedTutor==='french'? 'selected':'' %>>
                  French Tutor
                </option>
              </select>
            </div>
          </div>
          <br>
          <br>

          <!-- Chat window -->
          <div
            id="chatWindow"
            class="border rounded p-3 mb-4"
            style="height: 400px; overflow-y: auto; background: #f8f9fa;"
          ></div>

          <!-- Input + Send -->
          <div class="input-group">
            <input
              id="userInput"
              type="text"
              class="form-control"
              placeholder="Type your message..."
              aria-label="User message"
            />
            <button id="sendBtn" class="btn btn-accent" type="button">
              Send
            </button>
          </div>

        </div>
      </div>
    </div>
  </main>

  <!-- NAVBAR -->
  <%- include('templates/navbar', { activeTab: 'tutor' }) %>

  <!-- SCRIPTS -->
  <script>
    window.CHAT_HISTORY = <%= JSON.stringify(history) %>;
  </script>
  <script src="/js/tutor.js"></script>
</body>
</html>
