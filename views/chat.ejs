<nav class="navbar fixed-top px-3 d-flex justify-content-between align-items-center shadow-sm position-relative"
     style="height: 56px; background-color: white; border-bottom: 1px solid #ccc; padding-top: 15px">
  <!-- Left: Back button -->
  <a class="btn" onclick="location.href='/messages'" aria-label="Messages" style="padding-left: 10px; padding-top: 5px;">
    <img src="/svgs/arrow.svg" width="24" height="24" alt="Back">
  </a>

  <!-- Center: Chat name -->
  <strong class="chat-title position-absolute start-50 translate-middle-x text-truncate">
    <%= chatId.replace(currentUser, '').replace('_', '') %>
  </strong>
</nav>


<style>
html, body {
  margin: 0;
  padding: 0;
  height: 100%;
  width: 100%;
  overflow: hidden;
  font-family: sans-serif;
}

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100vw;
  box-sizing: border-box;
  background-color: #EEE;
}

.chat-title {
  transform: translateX(-50%);
  left: 50%;
  position:absolute;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.chat-messages {
  flex: 1;
  padding: 20px;
  overflow-y: auto;
  background-color: #EEE;
}

.chat-message {
  width: fit-content;
  max-width: 70%;
  padding: 12px 16px;
  margin-bottom: 12px;
  border-radius: 16px;
  word-break: break-word;
}

.chat-message.user {
  background-color: #17caff;
  margin-left: auto;
  text-align: right;
}

.chat-message.friend {
  background-color: #ffa500;
  margin-right: auto;
  text-align: left;
}

.chat-input {
  display: flex;
  padding: 12px;
  margin-bottom: 75px;
  border-top: 1px solid #ccc;
  background-color: #fff;
}

.chat-input input[type="text"] {
  flex: 1;
  padding: 10px;
  border-radius: 20px;
  border: 1px solid #ccc;
  outline: none;
}

.chat-input button {
  margin-left: 10px;
  padding: 10px 20px;
  border-radius: 20px;
  white-space: nowrap;
}

.chat-message .meta {
  font-size: 0.75em;
  color: #666;
  margin-top: 4px;
}
</style>

<div class="chat-container">
  <div class="chat-messages" id="chatBox"
       data-chatid="<%= chatId %>"
       data-user="<%= currentUser %>">
    <% messages.forEach(function(message) { %>
      <div class="chat-message <%= message.user === currentUser ? 'user' : 'friend' %>">
        <div class="msg"><%= message.text %></div>
        <div class="meta text-muted" style="font-size: 0.8em;"><%= message.user %></div>
      </div>
    <% }); %>
  </div>

  <form action="/send-message" method="POST" class="chat-input">
    <input type="hidden" name="chatId" value="<%= chatId %>">
    <input type="text" name="message" placeholder="Type a message..." autocomplete="off" required>
    <button type="submit" class="btn btn-primary">Send</button>
  </form>
</div>

<script>
  const chatBox = document.getElementById('chatBox');
  chatBox.scrollTop = chatBox.scrollHeight;
</script>

<script src="/js/AJAXMessagepulling.js"></script>
