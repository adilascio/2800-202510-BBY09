<%- include('templates/navbar', { activeTab: 'messages' }) %>

<style>
html, body {
  margin: 0;
  padding: 0;
  height: 100%;
  width: 100%;
  overflow: hidden; /* Prevent scrolling on body */
  font-family: sans-serif;
}

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100vw;
  background-color: #f9f9f9;
  box-sizing: border-box;
}

.chat-messages {
  flex: 1;
  padding: 20px;
  overflow-y: auto;
  overflow-x: hidden;
}

.chat-message {
  max-width: 70%;
  padding: 12px 16px;
  margin-bottom: 12px;
  border-radius: 16px;
  word-wrap: break-word;
  word-break: break-word; /* handles very long words */
}

.chat-message.user {
  background-color: #d1e7dd;
  margin-left: auto;
  text-align: right;
}

.chat-message.friend {
  background-color: #e9ecef;
  margin-right: auto;
  text-align: left;
}

.chat-input {
  display: flex;
  padding: 12px;
  border-top: 1px solid #ccc;
  background-color: #fff;
}

.chat-input input[type="text"] {
  flex: 1;
  padding: 10px;
  border-radius: 20px;
  border: 1px solid #ccc;
  outline: none;
  max-width: 100%;
}

.chat-input button {
  margin-left: 10px;
  padding: 10px 20px;
  border-radius: 20px;
  white-space: nowrap;
}
</style>

<div class="chat-container">
  <div class="chat-messages" id="chatBox">
    <% messages.forEach(function(message) { %>
      <div class="chat-message <%= message.user === currentUser ? 'user' : 'friend' %>">
        <div class="msg"><%= message.text %></div>
        <div class="meta text-muted" style="font-size: 0.8em;"><%= message.user %></div>
      </div>
    <% }); %>
  </div>

  <form action="/send-message" method="POST" class="chat-input">
    <input type="hidden" name="chatId" value="<%= chatId %>">
    <input type="text" name="message" placeholder="Type a message..." autocomplete="off" required>
    <button type="submit" class="btn btn-primary">Send</button>
  </form>
</div>

<script>
// Auto-scroll to bottom on load (safe because overflow-y is handled inside .chat-messages)
const chatBox = document.getElementById('chatBox');
chatBox.scrollTop = chatBox.scrollHeight;
</script>
